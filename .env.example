# Copy to .env (setup_aws.sh writes it for you)
AWS_REGION=eu-central-1
# Which ~/.aws profile to use (keeps work and personal accounts apart)
AWS_PROFILE=personal
CLAIMS_BUCKET=claim-documents-poc-xx
# 1 = run everything offline with a fake model + local folder (no AWS cost)
MOCK_MODE=0

# Optional overrides - cross-region inference profile prefix is added automatically
# (us. / eu. / apac.) based on AWS_REGION
# EXTRACTION_MODEL=eu.amazon.nova-pro-v1:0
# SUMMARY_MODEL=eu.amazon.nova-lite-v1:0
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# COMPARE_MODELS=eu.amazon.nova-micro-v1:0,eu.amazon.nova-lite-v1:0,eu.amazon.nova-pro-v1:0,eu.anthropic.claude-3-haiku-20240307-v1:0
